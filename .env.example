# LOCAL DEVELOPMENT ONLY. Copy (don't rename) to .env.local and fill in the Neon *Development* values.
# Never put production credentials here: production runs on Cloudflare (secrets via
# `wrangler secret put`, database via Hyperdrive), and production migrations use .env.prod
# (see .env.prod.example). All .env* files except the examples are git-ignored.

APP_ENV=development

# --- Neon Development branch ---
# Pooled connection (host contains -pooler): app traffic.
DATABASE_URL=
# Direct connection (same host without -pooler): migrations.
DATABASE_URL_UNPOOLED=
# Endpoint id of the Development branch, e.g. ep-small-forest-a1b2c3d4 (public id, not a secret).
# The app refuses to connect if DATABASE_URL points at any other endpoint.
DATABASE_ENDPOINT=
NEON_BRANCH=Development

# --- App ---
APP_ORIGIN=http://localhost:3000
# 32+ random characters. Signs staff sessions and receipt links. Rotating it signs everyone out
# and invalidates existing receipt links (set RECEIPT_SECRET separately to decouple them).
BETTER_AUTH_SECRET=
RECEIPT_SECRET=
BRANCH_ID=00000000-0000-4000-8000-000000000002
# Optional: only this email may create the first owner account at /setup.
OWNER_EMAIL=
# "true" only on branches seeded with fictional data (shows demo banner and demo logins).
DEMO_MODE=false

# --- Background worker (Vercel Cron sends CRON_SECRET; other schedulers use WORKER_SECRET) ---
CRON_SECRET=
WORKER_SECRET=

# --- Optional integrations ---
PAYSTACK_SECRET_KEY=
MNOTIFY_API_KEY=
MNOTIFY_SENDER=ChicsChips
SENTRY_DSN=
