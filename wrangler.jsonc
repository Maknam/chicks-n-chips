{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chicks-n-chips",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "chicks-n-chips"
    }
  ],
  // Production: GitHub main → Cloudflare Workers → Hyperdrive → Supabase PostgreSQL.
  // The app reads its database ONLY from this binding on Workers (db/client.ts); there is no
  // DATABASE_URL secret. Create the config (Supabase session pooler, sslmode verify-full against
  // Supabase's CA, caching disabled) with `node --env-file=.env.prod scripts/create-hyperdrive.mjs`,
  // then paste the returned id below. The id is not a secret.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "0ee7978eb2f04eb3ad92fb6927db05aa",
      // Local emulation only; never uploaded or used by the deployed Worker. `opennextjs-cloudflare
      // deploy` starts Wrangler's local platform proxy just to read `vars`, and local Hyperdrive
      // refuses to start without a connection string. This placeholder (dummy credentials, nothing
      // listening) satisfies it without any real credentials in CI. For `npm run preview`, set
      // CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE (Neon Development), which overrides it.
      "localConnectionString": "postgresql://local-placeholder:local-placeholder@127.0.0.1:5432/local-placeholder"
    }
  ],
  // Non-secret values only. Secrets: `npx wrangler secret put <NAME>` for BETTER_AUTH_SECRET,
  // RECEIPT_SECRET, WORKER_SECRET and, when enabled, PAYSTACK_SECRET_KEY, MNOTIFY_API_KEY.
  "vars": {
    "APP_ENV": "production",
    // Supabase project ref (public id), reported by /api/health for verification.
    "DATABASE_ENDPOINT": "",
    // Public URL of the production site, e.g. https://chicks-n-chips.<your-subdomain>.workers.dev
    "APP_ORIGIN": "",
    // Only this email may create the first owner account at /setup.
    "OWNER_EMAIL": "",
    "DEMO_MODE": "false",
    "MNOTIFY_SENDER": "ChicsChips",
    "RESTAURANT_ID": "00000000-0000-4000-8000-000000000001",
    "BRANCH_ID": "00000000-0000-4000-8000-000000000002"
  },
  "observability": { "enabled": true }
}
