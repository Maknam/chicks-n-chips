{
  "name": "chics-and-chips-mvp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "build:worker": "node scripts/guard-worker-build.mjs && opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "node scripts/guard-worker-build.mjs && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write app components lib tests scripts *.ts *.mjs",
    "db:seed": "tsx --env-file=.env.local scripts/seed.ts",
    "db:seed:prod": "tsx --env-file=.env.prod scripts/seed.ts",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "db:migrate:prod": "tsx --env-file=.env.prod scripts/migrate.ts --production",
    "db:status": "tsx --env-file=.env.local scripts/db-status.ts",
    "db:status:prod": "tsx --env-file=.env.prod scripts/db-status.ts",
    "db:verify:prod": "tsx --env-file=.env.prod scripts/db-verify.ts",
    "db:harden:prod": "tsx --env-file=.env.prod scripts/db-harden.ts",
    "db:studio": "drizzle-kit studio",
    "staff:create": "tsx --env-file=.env.local scripts/create-staff.ts"
  },
  "dependencies": {
    "@neon/config": "^1.10.0",
    "@neon/env": "^1.6.8",
    "@vercel/functions": "^3.10.1",
    "better-auth": "^1.7.11",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^0.468.0",
    "next": "^16.3.5",
    "pg": "^8.23.1",
    "pg-cloudflare": "^1.4.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@opennextjs/cloudflare": "^1.20.6",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.3",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "prettier": "^3.9.7",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "wrangler": "^4.133.0"
  }
}
