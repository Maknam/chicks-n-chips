# PRODUCTION DATABASE ADMIN ONLY (migrations, status, seed, backups). Copy (don't rename) to
# .env.prod on the one machine that administers production. Next.js and OpenNext never read
# .env.prod, so it is never bundled. The running production app does NOT use this file: on
# Cloudflare it connects through Hyperdrive.

APP_ENV=production

# --- Supabase production ---
# Use the SESSION pooler (port 5432) or the direct connection; never the transaction pooler (6543).
# Supabase signs its certificates with its own CA: download it from Project Settings → Database →
# SSL Configuration and save it as certs/supabase-prod-ca.crt (git-ignored).
# Format:
# postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=certs/supabase-prod-ca.crt
DATABASE_URL_UNPOOLED=
# Supabase project ref, e.g. abcdefghijklmnopqrst
DATABASE_ENDPOINT=
